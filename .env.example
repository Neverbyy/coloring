# Postgres (Supabase). Приложение — через transaction pooler (6543)
NUXT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Миграции drizzle-kit — через session pooler (5432), DDL там надёжнее
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Supabase Realtime — сигнал «галерея изменилась» после правок в админке (база подключена напрямую, не через API).
# Адрес и publishable-ключ публичные (уходят в браузер), secret — только сервер. Без них галерея обновляется как раньше.
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NUXT_SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
